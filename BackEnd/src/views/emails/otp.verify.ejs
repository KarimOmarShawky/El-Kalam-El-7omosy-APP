<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome Aboard</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color: #f4f7f6; padding: 40px 0;">
    <tr>
        <td align="center">
            <table role="presentation" width="100%" style="max-width: 500px; background-color: #ffffff; border-radius: 12px; padding: 40px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                <!-- Header Icon / Title -->
                <tr>
                    <td align="center" style="padding-bottom: 10px;">
                        <div style="background-color: #ecfdf5; color: #10b981; font-size: 36px; height: 64px; width: 64px; line-height: 64px; border-radius: 50%; display: inline-block; text-align: center;">✓</div>
                    </td>
                </tr>
                <tr>
                    <td align="center" style="padding-bottom: 20px;">
                        <h2 style="color: #1a1a1a; margin: 10px 0 0 0; font-size: 24px; font-weight: 700;">Account Verified!</h2>
                    </td>
                </tr>

                <!-- Content -->
                <tr>
                    <td style="color: #555555; font-size: 15px; line-height: 1.6; text-align: center;">
                        <p style="margin-top: 0;">Welcome aboard, <strong><%= userName %></strong>!</p>
                        <p>Your account has been successfully verified. You now have full access to all features on our platform.</p>
                    </td>
                </tr>

                <!-- Call to Action Button -->
                <tr>
                    <td align="center" style="padding: 25px 0;">
                        <a href="<%= dashboardUrl %>" style="background-color: #10b981; color: #ffffff; text-decoration: none; padding: 12px 28px; border-radius: 6px; font-weight: 600; font-size: 15px; display: inline-block;">Go to Dashboard</a>
                    </td>
                </tr>

                <!-- Footer -->
                <tr>
                    <td style="color: #888888; font-size: 13px; line-height: 1.5; text-align: center; border-top: 1px solid #eeeeee; padding-top: 20px;">
                        <p style="margin: 0;">We're excited to have you with us. If you have any questions, feel free to reach out to our team.</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>